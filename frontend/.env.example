# URL pública del backend (sin barra final). Opciones:
# - Build: VITE_API_URL (queda fija en el bundle)
# - Runtime (recomendado Cloud Run frontend): PUBLIC_API_URL en el servicio → /runtime-config.js
# Ejemplo: https://ollinx-backend-xxxxx.run.app
# Desarrollo con proxy Vite: ambos vacíos.
VITE_API_URL=
# PUBLIC_API_URL=
